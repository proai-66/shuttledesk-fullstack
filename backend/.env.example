# Same Supabase project as the frontend (js/config.js SUPABASE_URL / SUPABASE_ANON_KEY)
SUPABASE_URL=https://qpyhfoaeklkwkoudjnro.supabase.co
SUPABASE_ANON_KEY=sb_publishable_6dNw4OkobcRyxE8TMmX8AQ_cmC3C-v9

# Supabase dashboard → Project Settings → API → service_role key.
# ONLY used for admin.createUser() (creating a new login without an email-confirm
# round trip). Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Same key the old supabase/functions/parse-ticket edge function used
# (supabase secrets set GEMINI_API_KEY=...) — now called from this backend instead.
GEMINI_API_KEY=

# Comma-separated list of origins allowed to call this API (your frontend's
# Live Server URL). Example: http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

PORT=3001
